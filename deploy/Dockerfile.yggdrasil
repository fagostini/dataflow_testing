# Yggdrasil daemon image for the local compose test stack.
#
# Build context is the repository ROOT (see docker-compose.yml), so COPY
# paths are relative to it. Submodules are otherwise left untouched.
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1

# curl: used by the entrypoint for CouchDB readiness probes / bootstrap.
# poppler-utils: runtime dep of pdf2image (some plan steps may render PDFs).
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl ca-certificates poppler-utils \
    && rm -rf /var/lib/apt/lists/*

RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

WORKDIR /app

# 1) Pinned runtime dependencies first (better layer caching).
COPY Yggdrasil/requirements/lock.txt /tmp/ygg-requirements/lock.txt
RUN pip install -r /tmp/ygg-requirements/lock.txt

# 2) Yggdrasil source; editable install so the `lib` and `yggdrasil`
#    packages resolve from /app. SETUPTOOLS_SCM_PRETEND_VERSION keeps
#    setuptools-scm from demanding git metadata inside the image.
COPY Yggdrasil/ /app/
ENV SETUPTOOLS_SCM_PRETEND_VERSION=0.1.0
RUN pip install -e /app

# 2b) The demux_realm realm package (ygg.realm entry point: dmx_realm).
#     --no-deps: its declared deps (prefect, pandas, click) are not imported
#     anywhere in the package; it only uses stdlib + yggdrasil (already
#     installed, editable, /app). Its `ygg` extra would git-install a second
#     yggdrasil and shadow this one.
COPY demux_realm/ /app/demux_realm/
RUN pip install --no-deps -e /app/demux_realm

# 3) Config, scenario seed and entrypoint. All files ConfigLoader resolves
#    must live under yggdrasil_workspace/common/configurations/ (CONFIG_DIR).
COPY deploy/yggdrasil-config/main.json /app/yggdrasil_workspace/common/configurations/main.json
COPY Yggdrasil/module_registry.json /app/yggdrasil_workspace/common/configurations/module_registry.json
COPY deploy/seed/test_scenario_happy_path.json /app/scenario_seed.json
COPY deploy/yggdrasil-entrypoint.sh /usr/local/bin/yggdrasil-entrypoint.sh
RUN chmod +x /usr/local/bin/yggdrasil-entrypoint.sh

ENTRYPOINT ["yggdrasil-entrypoint.sh"]
CMD ["--dev", "daemon"]