# Copy to .env and adjust as needed. The stack runs with these defaults
# even without a .env file.

# CouchDB credentials for the stack. The STACK_ prefix keeps these from
# colliding with COUCHDB_* variables that may exist in your shell for
# other purposes. Used by the statusdb image (seed script included) and
# mirrored into yggdrasil as YGG_COUCH_USER/YGG_COUCH_PASS.
# NOTE: deploy/genomics-status/settings.yaml hardcodes the same defaults;
# update it too if you change the credentials.
STACK_COUCH_USER=admin
STACK_COUCH_PASSWORD=secret

# Host user id the biomate container runs as (kept from the upstream
# convention). genomics-status runs as root with its source baked into the
# image, so it does not use these.
HOST_UID=1000
HOST_GID=1000

# yggdrasil entrypoint: inject a happy_path test scenario on container
# start so the daemon has something to plan and execute immediately.
YGG_INJECT_TEST_SCENARIO=true
# Document id of the injected scenario (skip injection if it already exists).
# `make compose-scenario` injects a fresh uniquely-named one instead.
YGG_SCENARIO_ID=test_scenario:compose-demo